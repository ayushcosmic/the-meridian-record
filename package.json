{
  "name": "the-meridian-record",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm test -w server",
    "seed": "npm run seed -w server",
    "seed:admin": "npm run seed:admin -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
