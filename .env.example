NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
SITE_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/meridian_record
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=editor@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-min-14-chars-Abc123!@#
COOKIE_SECURE=false

# Google AdSense Monetization (Leave blank for clean non-deceptive placeholders)
ADSENSE_CLIENT_ID=
ADSENSE_HEADER_SLOT=
ADSENSE_SIDEBAR_SLOT=
ADSENSE_INARTICLE_SLOT=

# Optional Cloudinary image upload (Without these values, built-in secure local upload is used)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
